#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <11 12>;
            bindings = <&kp TAB>;
        };

        combo_shiftTab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        combo_doublequate {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <15 16>;
        };

        L_brance {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <5 6>;
        };

        R_brance {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <6 7>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <7 8>;
        };

        Equal {
            bindings = <&kp EQUAL>;
            key-positions = <8 9>;
        };

        single_quate {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <16 17>;
        };

        pipe {
            bindings = <&kp BACKSLASH>;
            key-positions = <3 4>;
        };
    };

    // =============================================
    // マクロ: BTプロファイル切り替え + レイヤー切り替えを同時に実行
    // to_win → プロファイル1（Windows）+ layer5へ
    // to_mac → プロファイル0（Mac）    + layer0へ
    // =============================================

    macros {
        to_win: to_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 5>;
        };

        to_mac: to_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Mac用 QWERTYレイヤー（デフォルト）
        // 左下3番目: &kp LCTRL（Ctrlキー）
        // 左下5番目: &kp LCMD（⌘コマンドキー）

        default_layer {
            bindings = <
&kp Q      &kp W     &kp E             &kp R        &kp T                 &kp Y      &kp U        &kp I          &kp O      &kp P
&kp A      &kp S     &kp D             &kp F        &kp G                 &kp H      &kp J        &kp K          &kp L      &kp SEMI
&kp Z      &kp X     &kp C             &kp V        &kp B                 &kp N      &kp M        &kp COMMA      &kp DOT    &kp APOS
&kp LCTRL  &kp LALT  &kp LEFT_COMMAND  &lt 2 LANG2  &mt LEFT_SHIFT SPACE  &kp ENTER  &lt 1 LANG1  &kp BACKSPACE  &kp SLASH  &kp DELETE
            >;
        };

        // Layer 1: 数字・矢印レイヤー（変更なし）

        layer1 {
            label = "NUMBER";
            bindings = <
&kp N0     &kp N1  &kp N2  &kp N3     &kp TAB  &kp MINUS  &kp PLUS   &trans    &kp TILDE  &kp UNDER
&kp EQUAL  &kp N4  &kp N5  &kp N6     &trans   &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &trans
&trans     &kp N7  &kp N8  &kp N9     &trans   &kp ASTRK  &kp SLASH  &kp LBKT  &kp RBKT   &trans
&trans     &trans  &trans  &kp LSHFT  &trans   &trans     &trans     &trans    &trans     &trans
            >;
        };

        // Layer 2: BT・ファンクションレイヤー
        // Qキー → &to_win（Windows切り替え）
        // Wキー → &to_mac（Mac切り替え）

        layer2 {
            label = "FUNCTION";
            bindings = <
&to_win  &to_mac  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&trans   &trans   &trans        &trans        &bt BT_CLR      &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans   &trans   &trans        &trans        &bt BT_CLR_ALL  &kp F11  &kp F12  &trans  &trans  &trans
&trans   &trans   &trans        &trans        &trans          &kp DEL  &trans   &trans  &trans  &trans
            >;
        };

        // Layer 3: マウスレイヤー（手動用）
        // 注意: &to 0 は常にMacレイヤー(layer0)に戻ります

        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &trans  &trans    &trans    &trans  &kp PAGE_UP    &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans     &trans  &trans    &trans    &trans  &kp PAGE_DOWN  &trans    &trans    &trans    &trans
&trans     &trans  &trans    &trans    &trans  &trans         &trans    &trans    &trans    &trans
&kp LSHFT  &trans  &kp LCMD  &kp LALT  &to 0   &trans         &trans    &trans    &to 0     &kp RALT
            >;
        };

        // Layer 4: 予備（空きレイヤー）

        layer4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Layer 5: Windows用 QWERTYレイヤー
        // layer0との違い: 左下3番目が &kp LCMD（Command/Windowsキー）
        //                 左下5番目が &kp LCTRL（Ctrlキー）
        //                 右手Shift位置のひとつが &kp DEL（Deleteキー）

        layer5 {
            label = "WINDOWS";
            bindings = <
&kp Q      &kp W     &kp E         &kp R        &kp T                 &kp Y      &kp U        &kp I          &kp O      &kp P
&kp A      &kp S     &kp D         &kp F        &kp G                 &kp H      &kp J        &kp K          &kp L      &kp SEMI
&kp Z      &kp X     &kp C         &kp V        &kp B                 &kp N      &kp M        &kp COMMA      &kp DOT    &kp APOS
&kp LCTRL  &kp LALT  &kp LEFT_WIN  &lt 7 LANG2  &mt LEFT_SHIFT SPACE  &kp ENTER  &lt 8 LANG1  &kp BACKSPACE  &kp SLASH  &kp DELETE
            >;
        };

        // Layer 6: オートマウスレイヤー
        // Windowsレイヤー(layer5)より上に置いて、Windows使用時も優先されるようにする

        layer6 {
            label = "AUTO_MOUSE";
            bindings = <
&trans     &trans  &trans    &trans    &trans  &kp PG_UP      &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans     &trans  &trans    &trans    &trans  &kp PAGE_DOWN  &trans    &trans    &trans    &trans
&trans     &trans  &trans    &trans    &trans  &trans         &trans    &trans    &trans    &trans
&kp LSHFT  &trans  &kp LCMD  &kp LALT  &to 0   &trans         &trans    &trans    &to 0     &kp RALT
            >;
        };

        // Layer 7: Windows用 BT・ファンクションレイヤー
        // Windowsレイヤー(layer5)より上に置いて、Windows使用時もMacへ戻れるようにする

        layer7 {
            label = "WIN_FUNCTION";
            bindings = <
&to_win  &to_mac  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&trans   &trans   &trans        &trans        &bt BT_CLR      &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans   &trans   &trans        &trans        &bt BT_CLR_ALL  &kp F11  &kp F12  &trans  &trans  &trans
&trans   &trans   &trans        &trans        &trans          &kp DEL  &trans   &trans  &trans  &trans
            >;
        };

        // Layer 8: Windows用 数字・矢印レイヤー
        // Windowsレイヤー(layer5)より上に置いて、Windows使用時もLayer 1相当を使えるようにする

        layer8 {
            label = "WIN_NUMBER";
            bindings = <
&kp N0     &kp N1  &kp N2  &kp N3     &kp TAB  &kp MINUS  &kp PLUS   &trans    &kp TILDE  &kp LS(INT1)
&kp EQUAL  &kp N4  &kp N5  &kp N6     &trans   &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &trans
&trans     &kp N7  &kp N8  &kp N9     &trans   &kp ASTRK  &kp SLASH  &kp LBKT  &kp RBKT   &trans
&trans     &trans  &trans  &kp LSHFT  &trans   &trans     &trans     &trans    &trans     &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
